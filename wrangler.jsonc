{
  // Cloudflare Workers — static assets only (no Worker script).
  // Everything in ./public is served as-is; "/" serves index.html.
  // Docs: https://developers.cloudflare.com/workers/static-assets/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "accelerated-jam-tracks",
  "compatibility_date": "2026-09-06",
  "assets": {
    "directory": "./public"
  }
}
